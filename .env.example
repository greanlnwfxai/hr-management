# .env.example — safe placeholder template
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=hr_management

# ── API — Database URL ────────────────────────────────────────────────────────
# For Docker Compose, the host is the service name (e.g. "db").
# For local non-Docker dev, use "localhost".
DATABASE_URL=postgresql://hr_user:CHANGE_THIS_PASSWORD@db:5432/hr_management

# ── API — JWT ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h

# ── API — CORS ────────────────────────────────────────────────────────────────
# Single origin or comma-separated list. No wildcards in production.
# Example production value: CORS_ORIGIN=https://app.example.com
CORS_ORIGIN=http://localhost:3002

# ── API — Rate Limiting ───────────────────────────────────────────────────────
# Values are in SECONDS. Internally converted to milliseconds by the API.
# Default API rate limit (all routes): 100 requests per 60 seconds per IP
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Login endpoint rate limit: 5 requests per 60 seconds per IP
LOGIN_THROTTLE_TTL=60
LOGIN_THROTTLE_LIMIT=5

# ── Frontend ──────────────────────────────────────────────────────────────────
# Must be the publicly reachable API URL from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4002
