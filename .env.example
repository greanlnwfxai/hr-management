# .env.example — safe placeholder template
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=hr_management

# ── API — Database URL ────────────────────────────────────────────────────────
# For Docker Compose, the host is the service name (e.g. "db").
# For local non-Docker dev, use "localhost".
DATABASE_URL=postgresql://hr_user:CHANGE_THIS_PASSWORD@db:5432/hr_management

# ── API — JWT ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h

# ── API — CORS ────────────────────────────────────────────────────────────────
# Single origin or comma-separated list. No wildcards in production.
# Example production value: CORS_ORIGIN=https://app.example.com
CORS_ORIGIN=http://localhost:3002

# ── API — Rate Limiting ───────────────────────────────────────────────────────
# Values are in SECONDS. Internally converted to milliseconds by the API.
# Default API rate limit (all routes): 100 requests per 60 seconds per IP
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Login endpoint rate limit: 5 requests per 60 seconds per IP
LOGIN_THROTTLE_TTL=60
LOGIN_THROTTLE_LIMIT=5

# ── Frontend ──────────────────────────────────────────────────────────────────
# Must be the publicly reachable API URL from the browser.
# ⚠ NEXT_PUBLIC_* vars are baked into the JS bundle at image BUILD time.
#   Changing this after building the image requires a rebuild.
# Local development:                    http://localhost:4002
# Production (path-prefix, one domain): https://hr.example.com/api
# Production (separate subdomain):      https://api.hr.example.com
# Required (no default) in docker-compose.production.yml — stack will not start if unset.
NEXT_PUBLIC_API_URL=http://localhost:4002

# ── Production — Reverse Proxy ────────────────────────────────────────────────
# PUBLIC_APP_URL: used by docker-compose.prod.yml (overlay) to derive NEXT_PUBLIC_API_URL.
# Not used by docker-compose.production.yml (standalone) — set NEXT_PUBLIC_API_URL directly.
PUBLIC_APP_URL=https://hr.example.com

# TRUST_PROXY: set to "true" when the API runs behind a reverse proxy (production).
# Enables Express trust proxy so X-Forwarded-For is used for correct client IP
# extraction — required for per-client rate limiting behind a load balancer.
# Defaults to "true" in docker-compose.production.yml. Leave "false" for local dev.
TRUST_PROXY=false

# ── API — Swagger / OpenAPI ───────────────────────────────────────────────────
# SWAGGER_ENABLED: set to "false" in production to disable the public Swagger UI.
# Defaults to "true" (enabled) when unset — safe for local development.
# Production recommendation: disable Swagger or protect it behind VPN/auth proxy.
SWAGGER_ENABLED=true
# SWAGGER_PATH: URL path for Swagger UI (default: "docs")
# Swagger UI:   http://localhost:4002/docs
# OpenAPI JSON: http://localhost:4002/docs-json
SWAGGER_PATH=docs
