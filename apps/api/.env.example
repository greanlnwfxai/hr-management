# apps/api/.env.example
# Copy to apps/api/.env for local non-Docker development.
# This file is safe to commit. NEVER commit the actual .env.

# PostgreSQL connection (use localhost for direct local dev)
DATABASE_URL="postgresql://hr_user:CHANGE_THIS_PASSWORD@localhost:5432/hr_management?schema=public"

# JWT — must be a strong random secret in production
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h

# CORS — allowed browser origins (comma-separated, no wildcards in production)
CORS_ORIGIN=http://localhost:3002

# Rate limiting — values in SECONDS (API multiplies by 1000 for ms internally)
# Default API-wide limit
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Login endpoint-specific limit (stricter)
LOGIN_THROTTLE_TTL=60
LOGIN_THROTTLE_LIMIT=5

# Trust proxy — set to "true" when running behind Caddy/Nginx in production.
# Enables Express to trust X-Forwarded-For for correct client IP in rate limiting.
# Leave unset or "false" for local/direct access.
TRUST_PROXY=false

# Attendance Geofence
# Set ATTENDANCE_GEOFENCE_ENABLED=true to enforce location checks on mobile clock-in/out.
# Coordinates below are placeholder values — configure real values in production .env only.
ATTENDANCE_GEOFENCE_ENABLED=false
COMPANY_LATITUDE=13.7563
COMPANY_LONGITUDE=100.5018
COMPANY_GEOFENCE_RADIUS_METERS=100
ATTENDANCE_GPS_MAX_ACCURACY_METERS=100

# Swagger / OpenAPI
# Set SWAGGER_ENABLED=false in production to disable the public Swagger UI.
# Defaults to "true" when unset — safe for local development.
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
