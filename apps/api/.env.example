# apps/api/.env.example
# Copy to apps/api/.env for local non-Docker development.
# This file is safe to commit. NEVER commit the actual .env.

# PostgreSQL connection (use localhost for direct local dev)
DATABASE_URL="postgresql://hr_user:CHANGE_THIS_PASSWORD@localhost:5432/hr_management?schema=public"

# JWT — must be a strong random secret in production
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h

# CORS — allowed browser origins (comma-separated, no wildcards in production)
CORS_ORIGIN=http://localhost:3002
