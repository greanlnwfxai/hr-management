generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum LeaveType {
  SICK
  VACATION
  PERSONAL
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OffSiteStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkMode {
  ONSITE
  OFFSITE
}

enum AttendanceSource {
  COMPANY_GEOFENCE
  OFFSITE_PLANNED
  OFFSITE_UNPLANNED
}

enum AttendanceReviewStatus {
  AUTO_ACCEPTED
  PENDING_REVIEW
  APPROVED
  REJECTED
  MISSING_CHECKOUT
}

// SEC-ATT-004: distinct nonce scopes per attendance action/endpoint.
enum AttendanceNonceAction {
  CLOCK_IN
  CLOCK_OUT
  OFFSITE_CLOCK_IN
  OFFSITE_CLOCK_OUT
}

// SEC-ATT-007A: risk severity assigned to a recorded AttendanceRiskReview.
enum AttendanceRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// SEC-ATT-007A: HR/Admin review workflow state for a risk review row.
enum AttendanceRiskReviewStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
  IGNORED
}

// SEC-ATT-007A: what happened to the underlying attendance attempt. ACCEPTED
// is a valid value but is never written by the automatic scoring hooks (a
// fully clean attempt has nothing to review) — reserved for a possible future
// manual-flag path.
enum AttendanceRiskResult {
  ACCEPTED
  REJECTED
  FLAGGED
}

// ─────────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  username            String?   @unique
  password            String
  role                UserRole  @default(EMPLOYEE)
  mustChangePassword  Boolean   @default(false)
  passwordGeneratedAt DateTime?
  lastLoginAt         DateTime?
  isActive            Boolean   @default(true)
  employee            Employee?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([email])
  @@index([username])
  @@map("users")
}

model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  managerId   String?    @unique
  manager     Employee?  @relation("DepartmentManager", fields: [managerId], references: [id])
  employees   Employee[] @relation("DepartmentEmployees")
  positions   Position[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([name])
  @@map("departments")
}

model Position {
  id           String     @id @default(uuid())
  title        String
  description  String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([title, departmentId])
  @@index([departmentId])
  @@map("positions")
}

model Employee {
  id           String         @id @default(uuid())
  employeeCode String         @unique
  firstName    String
  lastName     String
  email        String         @unique
  phone        String?
  dateOfBirth  DateTime?      @db.Date
  hireDate     DateTime       @db.Date
  status       EmployeeStatus @default(ACTIVE)

  // Auth link
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Department & Position
  departmentId String
  department   Department @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  positionId   String
  position     Position   @relation(fields: [positionId], references: [id])

  // Reporting hierarchy
  managerId    String?
  manager      Employee?  @relation("EmployeeHierarchy", fields: [managerId], references: [id])
  subordinates Employee[] @relation("EmployeeHierarchy")

  // Back-relation: department this employee manages
  managedDepartment Department? @relation("DepartmentManager")

  // Activity relations
  attendances             Attendance[]
  leaveRequests           LeaveRequest[]   @relation("EmployeeLeaveRequests")
  approvedLeaves          LeaveRequest[]   @relation("ApprovedLeaveRequests")
  leaveBalances           LeaveBalance[]
  leaveAdjustments        LeaveAdjustment[] @relation("EmployeeLeaveAdjustments")
  offSiteRequests         OffSiteRequest[] @relation("EmployeeOffSiteRequests")
  approvedOffSiteRequests OffSiteRequest[] @relation("EmployeeApprovedOffSite")
  reviewedAttendances     Attendance[]     @relation("AttendanceReviewer")
  riskReviews             AttendanceRiskReview[]
  reviewedRiskReviews     AttendanceRiskReview[] @relation("AttendanceRiskReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
  @@index([status])
  @@map("employees")
}

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  workMode   WorkMode         @default(ONSITE)
  note       String?

  // Off-site fields
  attendanceSource  AttendanceSource       @default(COMPANY_GEOFENCE)
  reviewStatus      AttendanceReviewStatus?
  workLocationName  String?                @db.VarChar(200)
  offsiteReason     String?                @db.VarChar(500)

  // Off-site GPS (stored for dispute resolution per OQ#2; never in audit log)
  checkInLatitude                  Float?
  checkInLongitude                 Float?
  checkInAccuracyMeters            Float?
  checkInDistanceFromCompanyMeters Float?
  checkOutLatitude                 Float?
  checkOutLongitude                Float?
  checkOutAccuracyMeters           Float?
  checkOutDistanceFromCompanyMeters Float?

  // Off-site request link (planned path)
  offSiteRequestId String?
  offSiteRequest   OffSiteRequest? @relation(fields: [offSiteRequestId], references: [id])

  // Review fields (populated by REQ-002D admin review)
  reviewedById String?
  reviewedBy   Employee? @relation("AttendanceReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riskReviews AttendanceRiskReview[]

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@index([attendanceSource])
  @@index([reviewStatus])
  @@map("attendances")
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id])
  leaveType  LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  totalDays  Int
  reason     String?
  status     LeaveStatus @default(PENDING)

  approvedById String?
  approvedBy   Employee? @relation("ApprovedLeaveRequests", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([leaveType])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model LeaveBalance {
  id          String             @id @default(uuid())
  employeeId  String
  employee    Employee           @relation(fields: [employeeId], references: [id])
  leaveType   LeaveType
  year        Int
  totalDays   Int
  usedDays    Int                @default(0)
  adjustments LeaveAdjustment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([employeeId, leaveType, year])
  @@index([employeeId])
  @@index([year])
  @@map("leave_balances")
}

model LeaveAdjustment {
  id             String       @id @default(uuid())
  leaveBalanceId String
  leaveBalance   LeaveBalance @relation(fields: [leaveBalanceId], references: [id])
  deltaDays      Float
  reason         String
  actorUserId    String
  adjustedById   String?
  adjustedBy     Employee?    @relation("EmployeeLeaveAdjustments", fields: [adjustedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([leaveBalanceId])
  @@index([createdAt])
  @@index([actorUserId])
  @@map("leave_adjustments")
}

model OffSiteRequest {
  id           String        @id @default(uuid())
  employeeId   String
  employee     Employee      @relation("EmployeeOffSiteRequests", fields: [employeeId], references: [id])
  date         DateTime      @db.Date
  reason       String?
  status       OffSiteStatus @default(PENDING)
  approvedById String?
  approvedBy   Employee?     @relation("EmployeeApprovedOffSite", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  rejectReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  attendances Attendance[]

  @@index([employeeId])
  @@index([status])
  @@index([date])
  @@map("off_site_requests")
}

model GeofenceConfig {
  id                String   @id @default("default")
  enabled           Boolean  @default(false)
  latitude          Float?
  longitude         Float?
  radiusMeters      Int      @default(100)
  maxAccuracyMeters Int      @default(100)
  updatedByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("geofence_config")
}

// SEC-ATT-004: server-issued, single-use replay-protection nonce. Only a SHA-256
// hash of the nonce is stored (tokenHash) — the raw value is returned to the
// client once at issuance and never persisted. consumedAt is set atomically on
// first successful use; a non-null consumedAt makes the row permanently unusable.
model AttendanceNonce {
  id         String                @id @default(uuid())
  tokenHash  String                @unique
  userId     String
  employeeId String?
  action     AttendanceNonceAction
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("attendance_nonces")
}

// SEC-ATT-007A: privacy-safe risk/review-queue foundation. Never stores raw
// GPS coordinates, raw nonce values, tokens, or native-attestation
// assertions/tokens — only categorical reason codes, a derived risk level, and
// already-sanitized metadata (run through the same sanitizeMetadata() used by
// AuditLog). attendanceId is nullable and, in practice, null for every row
// created by the automatic scoring hooks: payload/nonce checks run before the
// attendance record is created or fetched (see attendance.service.ts), so
// there is nothing to link to yet at record-time. employeeId/userId are
// populated whenever available, so a row is still traceable even without an
// attendanceId.
model AttendanceRiskReview {
  id           String                     @id @default(uuid())
  employeeId   String?
  employee     Employee?                  @relation(fields: [employeeId], references: [id])
  attendanceId String?
  attendance   Attendance?                @relation(fields: [attendanceId], references: [id])
  userId       String?
  action       AttendanceNonceAction
  result       AttendanceRiskResult
  riskLevel    AttendanceRiskLevel
  reasonCodes  String[]
  status       AttendanceRiskReviewStatus @default(PENDING)
  source       String?
  platform     String?
  metadataJson Json?

  reviewedById String?
  reviewedBy   Employee? @relation("AttendanceRiskReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([attendanceId])
  @@index([status])
  @@index([riskLevel])
  @@index([createdAt])
  @@map("attendance_risk_reviews")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorRole   String?
  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  result      String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([result])
  @@map("audit_logs")
}
