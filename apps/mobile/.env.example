# Mobile app environment variables
# Copy this file to .env and adjust values for your local setup.
# EXPO_PUBLIC_* variables are embedded at build time — no secrets here.

# ── API base URL ──────────────────────────────────────────────────────────────
# iOS simulator:       http://localhost:4002
# Android emulator:    http://10.0.2.2:4002
# Physical device:     http://<your-local-lan-ip>:4002
EXPO_PUBLIC_API_BASE_URL=http://localhost:4002
