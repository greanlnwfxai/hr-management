{
  "expo": {
    "name": "HR Management",
    "slug": "hr-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "hr-mobile",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hrmanagement.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HR Management ใช้ตำแหน่งของคุณเพื่อยืนยันว่าคุณอยู่ในพื้นที่บริษัทก่อนลงเวลา"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a56db"
      },
      "package": "com.hrmanagement.mobile",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HR Management ใช้ตำแหน่งของคุณเพื่อยืนยันว่าคุณอยู่ในพื้นที่บริษัทก่อนลงเวลา"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": ""
    }
  }
}
