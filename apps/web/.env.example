# apps/web/.env.example
# Copy to apps/web/.env.local for local frontend development.
# This file is safe to commit. NEVER commit the actual .env.local.

# Public API base URL — must be reachable from the browser (not server-side).
# ⚠ NEXT_PUBLIC_* vars are baked into the JS bundle at build time.
#   Changing this after building requires a rebuild of the image.
# Local dev:                          http://localhost:4002
# Production (path-prefix, 1 domain): https://hr.example.com/api
# Production (separate subdomain):    https://api.hr.example.com
# In docker-compose.production.yml this is passed as a build arg — set it in root .env.
NEXT_PUBLIC_API_URL=http://localhost:4002
