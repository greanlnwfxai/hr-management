# deploy/caddy/Caddyfile.example
#
# Caddy v2 reverse proxy configuration for HR Management.
# Copy to your Caddyfile and replace app.example.com with your actual domain.
# Caddy handles TLS automatically (Let's Encrypt / ZeroSSL).
#
# ── How Caddy reaches the services ───────────────────────────────────────────
#
# When using docker-compose.production.yml (recommended), services are on the
# Docker network "hr_production" with no host port bindings. Caddy must be in
# the same network to use service names (web:3002, api:4002).
#
# Option A — Caddy in Docker (recommended with standalone compose):
#   Run Caddy as a Docker container and connect it to hr_production:
#
#     docker run -d --name caddy \
#       --network hr_production \
#       -p 80:80 -p 443:443 \
#       -v /etc/caddy/Caddyfile:/etc/caddy/Caddyfile \
#       -v caddy_data:/data \
#       caddy:2
#
#   Or, in a Caddy compose file:
#
#     networks:
#       hr_production:
#         external: true   # joins the network created by docker-compose.production.yml
#
# Option B — Caddy on the host (requires host-bound ports or container IPs):
#   Replace service names with localhost and the published port (if using dev compose),
#   or use `docker inspect hr-api-prod --format '{{.NetworkSettings.Networks.hr_production.IPAddress}}'`
#   to get container IPs. Option A is simpler for production.
#
# ── Single-domain layout ──────────────────────────────────────────────────────
#   app.example.com/api/*  → api:4002   (NestJS — strips /api prefix)
#   app.example.com/*      → web:3002   (Next.js)
#
# Note: api receives requests WITHOUT the /api prefix (uri strip_prefix /api).
# This matches NEXT_PUBLIC_API_URL=https://app.example.com/api in .env.
# The NestJS API does NOT have a /api global prefix configured.
#
# Note: TRUST_PROXY=true must be set in .env (or defaulted in production compose)
# so NestJS reads X-Forwarded-For for correct per-client rate limiting.

app.example.com {
    # Route /api/* to NestJS (strip the /api prefix before forwarding)
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:4002
    }

    # Route everything else to Next.js
    handle {
        reverse_proxy web:3002
    }

    # Optional: structured logging
    log {
        output file /var/log/caddy/hr-management.log
        format json
    }
}

# ── Alternative: separate subdomains ─────────────────────────────────────────
# Uncomment if you prefer api.example.com instead of the /api path prefix.
# Update NEXT_PUBLIC_API_URL=https://api.example.com and
# CORS_ORIGIN=https://app.example.com in .env accordingly.
#
# app.example.com {
#     reverse_proxy web:3002
# }
#
# api.example.com {
#     reverse_proxy api:4002
# }
