# deploy/nginx/hr-management.conf.example
#
# Nginx reverse proxy configuration for HR Management.
# Copy to /etc/nginx/sites-available/hr-management, symlink to sites-enabled.
# Replace app.example.com with your actual domain.
# TLS managed by certbot / Let's Encrypt (run certbot --nginx after setup).
#
# ── How Nginx reaches the services ───────────────────────────────────────────
#
# When using docker-compose.production.yml (recommended), services are on the
# Docker network "hr_production" with no host port bindings.
#
# Option A — Nginx in Docker (recommended with standalone compose):
#   Connect the Nginx container to the hr_production network:
#
#     docker network connect hr_production nginx-container-name
#
#   Then use service names: web:3002, api:4002.
#   See the upstream blocks below — they use service names by default.
#
# Option B — Nginx on the host:
#   If Nginx runs on the host (not in Docker), it cannot resolve Docker service
#   names. Use the container IP instead:
#     docker inspect hr-api-prod --format '{{.NetworkSettings.Networks.hr_production.IPAddress}}'
#   Or bind the production compose services to localhost only (change expose: to
#   ports: ["127.0.0.1:4002:4002"]) and use 127.0.0.1 as the upstream.
#
# ── Single-domain layout ──────────────────────────────────────────────────────
#   app.example.com/api/*  → api:4002   (NestJS — proxied as root, no /api prefix)
#   app.example.com/*      → web:3002   (Next.js)
#
# Note: TRUST_PROXY=true must be set in .env so NestJS reads X-Forwarded-For
# for correct per-client rate limiting (not the proxy IP).

upstream hr_api {
    server api:4002;
    keepalive 32;
}

upstream hr_web {
    server web:3002;
    keepalive 32;
}

# ── Redirect HTTP → HTTPS ─────────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;

    # Allow Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS ─────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.example.com;

    # ── TLS (managed by certbot / manual) ────────────────────────────────────
    ssl_certificate     /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # ── Security headers ──────────────────────────────────────────────────────
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer-when-downgrade always;

    # ── Proxy settings (shared) ───────────────────────────────────────────────
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";
    proxy_cache_bypass                 $http_upgrade;

    # ── Route /api/* → NestJS (strip /api prefix) ────────────────────────────
    # NestJS has no global /api prefix. Strip it here before forwarding.
    location /api/ {
        proxy_pass         http://hr_api/;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # ── Route /* → Next.js ───────────────────────────────────────────────────
    location / {
        proxy_pass         http://hr_web;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
